Add-Type -AssemblyName PresentationFramework
Add-Type -Path "C:\Program Files\Microsoft\Exchange\Web Services\2.2\Microsoft.Exchange.WebServices.dll"

# XAML tasarımı (xmlns:x eklendi!)
[xml]$xaml = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EWS Mail Gönderici" Height="500" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Kullanıcı:" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtUser" Margin="5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Parola:" Margin="5"/>
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="txtPass" Margin="5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Alıcı(lar):" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtTo" Margin="5" ToolTip="Birden fazla adresi ; ile ayırın"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Konu:" Margin="5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtSubject" Margin="5"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Mesaj:" Margin="5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtBody" Margin="5" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="200"/>

        <Button Grid.Row="5" Grid.Column="1" x:Name="btnSend" Content="Gönder"
                Width="100" Height="35" Margin="5" HorizontalAlignment="Right"
                Background="#0078D7" Foreground="White"/>
    </Grid>
</Window>
"@

# XAML yükle
$reader = (New-Object System.Xml.XmlNodeReader $xaml)
$window = [Windows.Markup.XamlReader]::Load($reader)

# Kontrolleri yakala
$txtUser    = $window.FindName("txtUser")
$txtPass    = $window.FindName("txtPass")
$txtTo      = $window.FindName("txtTo")
$txtSubject = $window.FindName("txtSubject")
$txtBody    = $window.FindName("txtBody")
$btnSend    = $window.FindName("btnSend")

# Gönder butonu görevini tanımlama satırı
$btnSend.Add_Click({
    try {
        $service = New-Object Microsoft.Exchange.WebServices.Data.ExchangeService([Microsoft.Exchange.WebServices.Data.ExchangeVersion]::Exchange2013_SP1)
        $service.Credentials = New-Object Microsoft.Exchange.WebServices.Data.WebCredentials($txtUser.Text, $txtPass.Password)
        $service.Url = "https://mail.assistt.com.tr/EWS/Exchange.asmx"

        $email = New-Object Microsoft.Exchange.WebServices.Data.EmailMessage($service)
        $email.Subject = $txtSubject.Text
        $email.Body = $txtBody.Text

        $txtTo.Text.Split(";") | ForEach-Object {
            if ($_ -and $_.Trim() -ne "") {
                $email.ToRecipients.Add($_.Trim())
            }
        }

        $email.SendAndSaveCopy()
        [System.Windows.MessageBox]::Show("Mail başarıyla gönderildi!","Başarılı")
    }
    catch {
        [System.Windows.MessageBox]::Show("Hata: $($_.Exception.Message)","Hata")
    }
})

# GUI Penceresini göster
$window.ShowDialog() | Out-Null
